# ============================================================
#  maps-scraper-api — Environment Variables
#  Copy to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3001
NUM_WORKERS=8                  # Match your VPS CPU count
LOG_LEVEL=info                 # debug | info | warn | error

# --- Security ---
# Set a strong random string to require x-api-key header from SaaS
API_KEY=your_secret_api_key_here

# --- CORS ---
# Comma-separated list of allowed origins for your React SaaS
# Leave blank or unset to allow all origins (not recommended in production)
ALLOWED_ORIGINS=https://your-saas.com,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_RPM=120             # Max requests per minute per IP

# --- Google Maps Extractor API ---
# URL where the Omkar desktop app is running (local on VPS)
MAPS_API_BASE_URL=http://localhost:3000
# How often to poll for task completion (ms)
MAPS_API_POLL_INTERVAL_MS=3000
# Max time to wait for a scrape to finish (ms) — 5 minutes default
MAPS_API_POLL_TIMEOUT_MS=300000

# --- Queue ---
# Concurrent scrapes per worker process
# 8 workers × 3 concurrent = 24 parallel scrapes max
# Lower this if the VPS runs out of memory (each Chrome tab ~200MB)
QUEUE_CONCURRENCY=3

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service-role key (never the anon key) for server-side
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

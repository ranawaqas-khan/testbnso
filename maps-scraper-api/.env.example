# ============================================================
#  maps-scraper-api — Environment Variables
#  Copy to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3001
NUM_WORKERS=8                    # Match your VPS CPU count
LOG_LEVEL=info                   # debug | info | warn | error

# --- Security ---
# Set a strong random string to require x-api-key header from SaaS
API_KEY=your_secret_api_key_here

# --- CORS ---
# Comma-separated list of allowed origins for your React SaaS
ALLOWED_ORIGINS=https://your-saas.com,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_RPM=120               # Max requests per minute per IP

# --- Google Maps Extractor API (Botasaurus Desktop — Omkar Cloud) ---
# The desktop app runs on port 8000 by default
MAPS_API_BASE_URL=http://localhost:8000
# Scraper name as registered in the app (leave blank to use the default scraper)
# Check http://localhost:8000/api/ui/config to see available scrapers
MAPS_SCRAPER_NAME=
# How often to poll for task completion (ms)
MAPS_API_POLL_INTERVAL_MS=3000
# Max time to wait for a scrape to finish (ms) — 5 minutes default
MAPS_API_POLL_TIMEOUT_MS=300000

# --- Queue ---
# Concurrent Botasaurus task submissions per worker process.
# Botasaurus Desktop manages Chrome sessions internally, so keep this low (1–3).
# 8 workers × 2 concurrent = 16 parallel task submissions
QUEUE_CONCURRENCY=2

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service-role key (never the anon key) for server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
